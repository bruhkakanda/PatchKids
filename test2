local isInternal = false
local Sync = nil

if getgc then
	for _, v in getgc(true) do
		if type(v) == "table" 
			and rawget(v, "Weapons")
			and rawget(v, "Item")
			and rawget(v, "Weapons") == rawget(v, "Item")
			and rawget(v, "Pets")
			and rawget(v, "MysteryBox") then
			Sync = v
			isInternal = true
			print("found Sync!")
			break
		end
	end
end
if not isInternal then
	Sync = nil
	warn("Sync is not able to be required with your current Executor. Some features may not work correctly.")
end

local ITEMDATA = Sync.Weapons["Emberbow"]
if ITEMDATA then
    setclipboard(ITEMDATA.ItemID)
end
