local function addEffects(button, hoverColor)
    local originalColor = button.BackgroundColor3
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = hoverColor}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = originalColor}):Play()
    end)
end

-- Completely Clear UI visibility except our system
local function toggleGameUI(visible)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    if not visible then
        -- Hide everything and cache original states
        for _, gui in pairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= "MM2WatcherUI" and gui.Enabled then
                table.insert(hiddenUIs, gui)
                gui.Enabled = false
            end
        end
        -- Hide main control panel, show minimalist floating escape button
        MainFrame.Visible = false
        MiniStopBtn.Visible = true
    else
        -- Restore original interface states
        for _, gui in pairs(hiddenUIs) do
            if gui and gui.Parent then
                gui.Enabled = true
            end
        end
        table.clear(hiddenUIs)
        -- Bring back full menu frame
        MainFrame.Visible = true
        MiniStopBtn.Visible = false
    end
end

-- Clear Loop Connection
local function stopSpectating()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
    currentTargetPlayer = nil
    
    -- Restore original layout
    toggleGameUI(true)
    
    -- Safe frame restore camera subject
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 3)
    if hum then
        workspace.CurrentCamera.CameraSubject = hum
    end
end

-- Find role via RemoteFunction
local function findRoleTarget(targetRole)
    local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not remote or not remote:IsA("RemoteFunction") then return nil end
    
    local success, roles = pcall(function() return remote:InvokeServer() end)
    if not success or not roles then return nil end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local playerData = roles[player.Name]
            if playerData and playerData.Role == targetRole then
                local hum = player.Character:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    return player
                end
            end
        end
    end
    return nil
end

-- Bind frame ticker loop
local function startSpectateLoop(targetRole)
    stopSpectating()
    
    local targetUser = findRoleTarget(targetRole)
    if not targetUser then return false end
    
    currentTargetPlayer = targetUser
    toggleGameUI(false) -- Enter Ghost UI layout immediately
    
    renderConnection = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if not camera then return end
        
        if currentTargetPlayer and currentTargetPlayer.Character then
            local targetHum = currentTargetPlayer.Character:FindFirstChild("Humanoid")
            if targetHum and targetHum.Health > 0 then
                if camera.CameraSubject ~= targetHum then
                    camera.CameraSubject = targetHum
                end
            else
                -- Target profile check fail/death -> Rescan or stop
                local nextTarget = findRoleTarget(targetRole)
                if nextTarget then
                    currentTargetPlayer = nextTarget
                else
                    stopSpectating()
                end
            end
        else
            stopSpectating()
        end
    end)
    
    return true, targetUser.Name
end

-- Local Respawn Watcher Persistence Anchor
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.2)
    if currentTargetPlayer and renderConnection then
        local targetHum = currentTargetPlayer.Character and currentTargetPlayer.Character:FindFirstChild("Humanoid")
        if targetHum then
            workspace.CurrentCamera.CameraSubject = targetHum
        end
    end
end)

