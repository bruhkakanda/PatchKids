local webhookLink = getgenv().webhookUrl

local plr = game.Players.LocalPlayer

local isInternal = false
local Sync = nil

if getgc then
	for _, v in getgc(true) do
		if type(v) == "table" 
			and rawget(v, "Weapons")
			and rawget(v, "Item")
			and rawget(v, "Weapons") == rawget(v, "Item")
			and rawget(v, "Pets")
			and rawget(v, "MysteryBox") then
			Sync = v
			isInternal = true
			print("found Sync!")
			break
		end
	end
end
if not isInternal then
	Sync = nil
	warn("Sync is not able to be required with your current Executor. Some features may not work correctly.")
end

function color3ToDiscord(color: Color3): number
	local r = math.round(color.R * 255)
	local g = math.round(color.G * 255)
	local b = math.round(color.B * 255)

	return (r * 65536) + (g * 256) + b
end

local RarityColors = {
		["Common"] = Color3.fromRGB(241, 241, 241),
		["Unknown"] = Color3.fromRGB(241, 241, 241),
		["Uncommon"] = Color3.fromRGB(107, 255, 250),
		["Rare"] = Color3.fromRGB(65, 255, 81),
		["Legendary"] = Color3.fromRGB(255, 33, 33),
		["Godly"] = Color3.fromRGB(255, 61, 252),
		["Ancient"] = Color3.fromRGB(178, 51, 255)
	}

	local function getItemImage(assetId)
		local s, response = pcall(request, {
			Url = "https://thumbnails.roblox.com/v1/assets?assetIds=" .. assetId .. "&returnPolicy=PlaceHolder&size=250x250&format=Png&isCircular=false",
			Method = "GET"
		})

		if not s then return nil end

		local s2, data = pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), response.Body)
		if not s2 then return nil end

		if data and data.data and data.data[1] then
			return data.data[1].imageUrl
		end

		return nil
	end

		local function SendMessage(url, itemName, rarity, playerName, id)
		local http = game:GetService("HttpService")

		local now = DateTime.now()
		local formatted = now:FormatLocalTime("M/D/YY, h:mm A", "en-us")

		local imgID = 584555920

		local title = "Auto Unbox"
		local action = "Unboxed"

		local itemType = "Item"
		if id then
			if id:find("_K_") then
				itemType = "Knife"
			elseif id:find("_G_") then
				itemType = "Gun"
			end
		end

		local EventEmojis = {
			["Summer"] = "Summer ",
			["Halloween"] = "Halloween ",
			["Christmas"] = "X-mas ",
			["Unknown"] = "? ",
		}

		local Event = "?"
		local Year = "Unknown"

		if Sync then
			local ITEMDATA = Sync.Weapons[id]
			if ITEMDATA then
				imgID = ITEMDATA.ItemID
				itemName = ITEMDATA.ItemName
				rarity = ITEMDATA.Rarity or "Common"
				Year = ITEMDATA.Year or " Unknown"
				Event = EventEmojis[ITEMDATA.Event or "Unknown"] or "?"

				warn("Found item data for:", id)
			end
		else
			if id == "Emberbow" then
				imgID = 109700223945658
				itemName = "Emberbow"
				rarity = "Ancient"
				Year = 2026
				Event = "Halloween "
			end
		end

		if id == "Emberbow" then
			title = "Purchased Final Tier"
			action = "Purchased"
		end

		local itemImageUrl = getItemImage(imgID) or ""

		local data = {
			["content"] = "**" .. playerName .. "** just ".. action:lower() .." a " .. itemType .. "!",
			["embeds"] = {
				{
					["title"] = title,
					["description"] = action .. ": **" .. itemName .. "**\nRarity: " .. rarity .. "\nEvent: " .. Event .. Year,
					["color"] = color3ToDiscord(RarityColors[rarity] or RarityColors["Common"]),
					["thumbnail"] = {
						["url"] = itemImageUrl
					},
					["footer"] = {
						["text"] = "Powered by PatchKids " .. formatted
					}
				}
			}
		}

		local body = http:JSONEncode(data)
		request({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body
		})
	end

SendMessage(webhookLink, "Emberbow", "Ancient", plr.Name, "Emberbow")
